{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // Vite's native config loader wants explicit .ts extensions.
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "vite.config.ts",
    "build-info.ts",
    "native-fingerprint.ts",
    "capacitor.config.ts",
    "electron/*"
  ]
}